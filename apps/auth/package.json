{
  "name": "@shesa/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shesa central authentication app — login / logout / reset / invite, writes the apex-domain Supabase Auth cookie shared by every Shesa subdomain.",
  "scripts": {
    "dev": "next dev --port 3001 --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --port 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium"
  },
  "dependencies": {
    "@shesa/config": "workspace:*",
    "@shesa/domain": "workspace:*",
    "@shesa/supabase": "workspace:*",
    "@shesa/types": "workspace:*",
    "@shesa/ui": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@shesa/eslint-config": "workspace:*",
    "@shesa/tsconfig": "workspace:*",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "@playwright/test": "^1.49.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
