# Dependencies
node_modules/
# pnpm content-addressable store — populated when an in-Docker `pnpm
# install` writes to the bind-mount root instead of the configured
# /pnpm/store volume. Local-only, never committed.
.pnpm-store/

# Build outputs
.next/
out/
dist/
build/
.turbo/
.vite/
*.tsbuildinfo

# Environment & secrets — block everything by default, allow only .env.example
.env
.env.*
!.env.example
!.env.example.*

# Certificates & keys — never commit
*.pem
*.key
*.crt
*.cert
*.cer
*.pfx
*.p12
secrets/
.secrets/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Tests & coverage
coverage/
playwright-report/
test-results/
.nyc_output/

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Husky internal (auto-generated by husky on install)
.husky/_/

# Supabase local runtime
supabase/.branches/
supabase/.temp/
supabase/.docker/
supabase/seed-overrides.sql

# Misc caches
.cache/

# Pre-cutover database exports — contain live data, never commit.
backup-*/
