{
  "name": "shesa",
  "private": true,
  "version": "0.0.0",
  "description": "Shesa platform monorepo — apps (web, auth, exco, finance, connect) and shared packages.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:open": "node scripts/dev-open.mjs",
    "compose:up": "docker compose -f infra/docker-compose.dev.yml up --build",
    "compose:down": "docker compose -f infra/docker-compose.dev.yml down",
    "compose:logs": "docker compose -f infra/docker-compose.dev.yml logs -f",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "supabase test db",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,scss,css}\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:migrate:new": "supabase migration new",
    "db:migrate": "supabase migration up",
    "db:diff": "supabase db diff",
    "db:diff:remote": "supabase db diff --linked",
    "db:lint": "supabase db lint",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local --schema public --schema core --schema audit > packages/supabase/src/types.gen.ts",
    "db:types:remote": "supabase gen types typescript --linked --schema public --schema core --schema audit > packages/supabase/src/types.gen.ts",
    "db:link": "node scripts/db-link.mjs",
    "db:push": "node scripts/db-push.mjs",
    "db:pull": "supabase db pull --linked",
    "env:init": "node scripts/env-init.mjs",
    "env:check": "node scripts/env-check.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "supabase": "^2.108.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
