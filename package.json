{
  "name": "shesa",
  "private": true,
  "version": "0.0.0",
  "description": "Shesa platform monorepo — apps (web, auth, exco, finance, connect) and shared packages.",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:open": "node scripts/dev-open.mjs",
    "compose:up": "docker compose -f infra/docker-compose.dev.yml up --build",
    "compose:down": "docker compose -f infra/docker-compose.dev.yml down",
    "compose:logs": "docker compose -f infra/docker-compose.dev.yml logs -f",
    "lint": "turbo run lint",
    "check:filenames": "node scripts/check-filenames.mjs",
    "gen:deno-mirrors": "node scripts/gen-deno-mirrors.mjs",
    "check:deno-mirrors": "node scripts/gen-deno-mirrors.mjs --check",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "node scripts/db.mjs test",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,scss,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,cjs,json,md,yaml,yml,scss,css}\"",
    "db": "node scripts/db.mjs",
    "db:start": "node scripts/db.mjs start",
    "db:stop": "node scripts/db.mjs stop",
    "db:status": "node scripts/db.mjs status",
    "db:reset": "node scripts/db.mjs reset",
    "db:test": "node scripts/db.mjs test",
    "db:diff": "node scripts/db.mjs diff",
    "db:lint": "node scripts/db.mjs lint",
    "db:types": "node scripts/db.mjs types",
    "db:seed": "node scripts/db.mjs seed",
    "db:seed:demo": "node scripts/db.mjs seed-demo",
    "db:push": "node scripts/db.mjs push",
    "db:migrate:new": "supabase migration new",
    "db:link": "node scripts/db-link.mjs",
    "db:pull": "supabase db pull --linked",
    "env:init": "node scripts/env-init.mjs",
    "env:check": "node scripts/env-check.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "supabase": "^2.108.0",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
