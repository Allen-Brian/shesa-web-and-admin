{
  "name": "@shesa/config",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Runtime config — Zod-validated env schemas (server + client), public URL helpers.",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./env.server": {
      "types": "./src/env.server.ts",
      "import": "./src/env.server.ts"
    },
    "./env.client": {
      "types": "./src/env.client.ts",
      "import": "./src/env.client.ts"
    },
    "./urls": {
      "types": "./src/urls.ts",
      "import": "./src/urls.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@shesa/types": "workspace:*",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@shesa/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
