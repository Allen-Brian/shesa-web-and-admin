      "import": "./src/errors/index.ts"
    },
    "./validators": {
      "types": "./src/validators/index.ts",
      "import": "./src/validators/index.ts"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "import": "./src/utils/index.ts"
    },
    "./rbac": {
      "types": "./src/rbac/index.ts",
      "import": "./src/rbac/index.ts"
    },
    "./audit": {
      "types": "./src/audit/index.ts",
      "import": "./src/audit/index.ts"
    },
    "./notifications": {
      "types": "./src/notifications/index.ts",
      "import": "./src/notifications/index.ts"
    },
    "./scopes": {
      "types": "./src/scopes/index.ts",
      "import": "./src/scopes/index.ts"
    },
    "./members": {
      "types": "./src/members/index.ts",
      "import": "./src/members/index.ts"
