{
  "name": "@shesa/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Shared UI — shadcn/ui components, Tailwind config, design tokens. Presentational only (no Supabase / domain imports).",
  "sideEffects": [
    "./src/theme/tokens.css",
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./tailwind.config": "./tailwind.config.ts",
    "./styles/tokens.css": "./src/theme/tokens.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17"
  },
  "devDependencies": {
    "@shesa/tsconfig": "workspace:*",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
