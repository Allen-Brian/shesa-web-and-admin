# Shesa env example — committed to the repo as a reference.
#
# Generate your own working .env.local with: `pnpm env:init`
# Audit which vars are set with: `pnpm env:check`
#
# This file documents EVERY variable. Some are auto-filled by env:init;
# some require you to paste a value from an external service. Values
# here are SAMPLES — do not use them in production.

# ─── Runtime identity ──────────────────────────────────────────────
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# ─── Apex domain (cookie scope for cross-subdomain SSO) ────────────
APP_BASE_DOMAIN=shesa.test
NEXT_PUBLIC_APP_BASE_DOMAIN=shesa.test

# ─── Per-app URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_WEB_APP_URL=http://web.shesa.test:3000
NEXT_PUBLIC_AUTH_APP_URL=http://auth.shesa.test:3001
NEXT_PUBLIC_EXCO_APP_URL=http://exco.shesa.test:3002
NEXT_PUBLIC_FINANCE_APP_URL=http://finance.shesa.test:3003
NEXT_PUBLIC_CONNECT_APP_URL=http://connect.shesa.test:3004

# ─── Supabase (captured from `supabase status` for local) ──────────
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<run `pnpm supabase status` and copy "anon key">
NEXT_PUBLIC_SUPABASE_ANON_KEY=<same as above>
SUPABASE_SERVICE_ROLE_KEY=<run `pnpm supabase status` and copy "service_role key" — SECRET>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── External services ─────────────────────────────────────────────
RESEND_API_KEY=<from https://resend.com → API Keys — SECRET>
EMAIL_FROM=Shesa Dev <dev@shesa.test>
SMS_PROVIDER_MODE=stub

# ─── Edge Function worker secret ───────────────────────────────────
# Gates the notification queue consumers (send-email, send-sms-stub,
# dispatch-notifications). They run as service_role with no caller
# identity to check, and `verify_jwt` is NOT a boundary — it accepts the
# public anon key, so without this anyone could drain the queues or burn
# the Resend quota.
#
# Generate with `openssl rand -hex 32`. Set it BOTH as an Edge Function
# secret and on whatever schedules the consumers, which must send it as
# the `x-worker-secret` header. The gate fails closed when unset: the
# consumers reject every call until it is configured.
NOTIFICATIONS_WORKER_SECRET=<`openssl rand -hex 32` — SECRET>

# ─── Payment gateway ───────────────────────────────────────────────
# None connected. Fapshi was removed on 2026-09-02; Tranzak is the
# intended replacement and its credentials land here when the
# integration does. AGM 2026 submissions are captured in
# cms.agm_registrations and settled out-of-band in the meantime.
