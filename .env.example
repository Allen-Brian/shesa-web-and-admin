# Shesa env example — committed to the repo as a reference.
#
# Generate your own working .env.local with: `pnpm env:init`
# Audit which vars are set with: `pnpm env:check`
#
# This file documents EVERY variable. Some are auto-filled by env:init;
# some require you to paste a value from an external service. Values
# here are SAMPLES — do not use them in production.

# ─── Runtime identity ──────────────────────────────────────────────
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# ─── Apex domain (cookie scope for cross-subdomain SSO) ────────────
APP_BASE_DOMAIN=shesa.test
NEXT_PUBLIC_APP_BASE_DOMAIN=shesa.test

# ─── Per-app URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_WEB_APP_URL=http://web.shesa.test:3000
NEXT_PUBLIC_AUTH_APP_URL=http://auth.shesa.test:3001
NEXT_PUBLIC_EXCO_APP_URL=http://exco.shesa.test:3002
NEXT_PUBLIC_FINANCE_APP_URL=http://finance.shesa.test:3003
NEXT_PUBLIC_CONNECT_APP_URL=http://connect.shesa.test:3004

# ─── Supabase (captured from `supabase status` for local) ──────────
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<run `pnpm supabase status` and copy "anon key">
NEXT_PUBLIC_SUPABASE_ANON_KEY=<same as above>
SUPABASE_SERVICE_ROLE_KEY=<run `pnpm supabase status` and copy "service_role key" — SECRET>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── External services ─────────────────────────────────────────────
RESEND_API_KEY=<from https://resend.com → API Keys — SECRET>
EMAIL_FROM=Shesa Dev <dev@shesa.test>
SMS_PROVIDER_MODE=stub

# ─── Fapshi (Cameroon MoMo/card gateway) ───────────────────────────
# Sign up: https://fapshi.com → Dashboard → Developers → New Service.
# Each service issues Sandbox AND Live credentials on separate tabs.
# The API key is shown ONCE — copy immediately.
#
# Base URL: https://sandbox.fapshi.com (dev/staging) or https://live.fapshi.com (prod).
FAPSHI_BASE_URL=https://sandbox.fapshi.com
FAPSHI_API_USER=<Dashboard → Developers → your service → Sandbox tab → apiuser>
FAPSHI_API_KEY=<Dashboard → Developers → your service → Sandbox tab → apikey — SECRET>

# Webhook secret — YOU generate this (`openssl rand -hex 32`) and paste
# it into the Fapshi dashboard under the same service's webhook config.
# Fapshi echoes it back in the `x-wh-secret` header on every callback.
FAPSHI_WEBHOOK_SECRET=<`openssl rand -hex 32` — SECRET>

# Reconcile secret — protects fapshi/reconcile from being called by
# anyone but pg_cron. Also `openssl rand -hex 32`. Stored as a DB GUC
# for pg_cron to send via net.http_post.
FAPSHI_RECONCILE_SECRET=<`openssl rand -hex 32` — SECRET>

# Where Fapshi should send the payer AFTER they finish the hosted
# checkout. We append /agm-2026/pending/<intentId> automatically.
# Local: use a public HTTPS tunnel (ngrok / cloudflared) — Fapshi
# requires HTTPS for the webhook + return URL in Live mode.
FAPSHI_RETURN_URL_BASE=http://web.shesa.test:3000
