# Shesa env example — committed to the repo as a reference.
#
# Generate your own working .env.local with: `pnpm env:init`
# Audit which vars are set with: `pnpm env:check`
#
# This file documents EVERY variable. Some are auto-filled by env:init;
# some require you to paste a value from an external service. Values
# here are SAMPLES — do not use them in production.

# ─── Runtime identity ──────────────────────────────────────────────
APP_ENV=local
NEXT_PUBLIC_APP_ENV=local

# ─── Apex domain (cookie scope for cross-subdomain SSO) ────────────
APP_BASE_DOMAIN=shesa.test
NEXT_PUBLIC_APP_BASE_DOMAIN=shesa.test

# ─── Per-app URLs ──────────────────────────────────────────────────
NEXT_PUBLIC_WEB_APP_URL=http://web.shesa.test:3000
NEXT_PUBLIC_AUTH_APP_URL=http://auth.shesa.test:3001
NEXT_PUBLIC_EXCO_APP_URL=http://exco.shesa.test:3002
NEXT_PUBLIC_FINANCE_APP_URL=http://finance.shesa.test:3003
NEXT_PUBLIC_CONNECT_APP_URL=http://connect.shesa.test:3004

# ─── Supabase (captured from `supabase status` for local) ──────────
SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=<run `pnpm supabase status` and copy "anon key">
NEXT_PUBLIC_SUPABASE_ANON_KEY=<same as above>
SUPABASE_SERVICE_ROLE_KEY=<run `pnpm supabase status` and copy "service_role key" — SECRET>
SUPABASE_DB_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ─── External services ─────────────────────────────────────────────
RESEND_API_KEY=<from https://resend.com → API Keys — SECRET>
EMAIL_FROM=Shesa Dev <dev@shesa.test>
SMS_PROVIDER_MODE=stub

# ─── Edge Function worker secret ───────────────────────────────────
# Gates the notification queue consumers (send-email, send-sms-stub,
# dispatch-notifications). They run as service_role with no caller
# identity to check, and `verify_jwt` is NOT a boundary — it accepts the
# public anon key, so without this anyone could drain the queues or burn
# the Resend quota.
#
# Generate with `openssl rand -hex 32`. Set it BOTH as an Edge Function
# secret and on whatever schedules the consumers, which must send it as
# the `x-worker-secret` header. The gate fails closed when unset: the
# consumers reject every call until it is configured.
NOTIFICATIONS_WORKER_SECRET=<`openssl rand -hex 32` — SECRET>

# ─── Database target ───────────────────────────────────────────────
# Which database `pnpm db <command>` talks to when no --target flag is
# given: `local` or `production`. Unset means local.
#
# Setting this to `production` in your shell makes EVERY db command in
# that shell hit production, so prefer the explicit per-command flag
# (`pnpm db diff --target production`) unless you are deliberately
# working against production for a while.
#
# Production credentials live in `.env.production`, never here.
# SHESA_DB_TARGET=local

# ─── Payment gateway (Tranzak) ─────────────────────────────────────
# TRANZAK_MODE selects which credential set is used and is recorded on
# every intent. There is NO default — an unset mode fails at boot,
# because guessing "live" collects money nobody authorised and guessing
# "sandbox" silently fails to collect money someone did.
TRANZAK_MODE=sandbox

# The credentials below belong to the Edge Function runtime, NOT to the
# Next apps. Set them with `supabase secrets set`, not in a Vercel
# project. Base URLs are not configurable: they are derived from the
# mode (sandbox.dsapi.tranzak.me / dsapi.tranzak.me) so a sandbox key
# cannot be pointed at the live host.
#
# A live application key carries a PROD_ prefix. Pasting one into the
# SANDBOX slot fails at boot rather than charging a real payer.
# Two different destinations, both real fields on request/create.
#
# RETURN_URL_BASE is where the payer's BROWSER goes after paying. Origin
# only — the path is per transaction and lives in code. It is pinned here
# rather than taken from the caller because Tranzak redirects to whatever
# returnUrl it is given and keeps no allow-list of its own; the public AGM
# path takes anonymous callers, so a caller-supplied URL is an open
# redirect.
TRANZAK_RETURN_URL_BASE=https://www.shesaconnect.com

# CALLBACK_URL is the server-to-server notification — Tranzak POSTs here
# when a request reaches a terminal state. Leave it unset and it defaults
# to this project's own Edge Function, derived from SUPABASE_URL so it
# cannot drift or point at the wrong project. Whatever receives it must
# hold the Tranzak credentials, because a settlement is only written after
# re-reading the transaction from Tranzak's API — the webhook body itself
# carries no signature and cannot be trusted. apps/web holds no
# credentials, so it cannot be the destination.
#
# Locally the derived value is http://kong:8000/... — the Docker-internal
# host, which Tranzak cannot reach. That is harmless (the request still
# succeeds; the notification just never arrives), but to receive webhooks
# on a dev machine you need a public tunnel and this variable set to it.
# TRANZAK_CALLBACK_URL=

TRANZAK_SANDBOX_APP_ID=
TRANZAK_SANDBOX_APP_KEY=
TRANZAK_SANDBOX_WEBHOOK_AUTH_KEY=

TRANZAK_LIVE_APP_ID=
TRANZAK_LIVE_APP_KEY=
TRANZAK_LIVE_WEBHOOK_AUTH_KEY=
