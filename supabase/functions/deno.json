{
  "$schema": "https://raw.githubusercontent.com/denoland/deno/main/cli/schemas/config-file.v1.json",
  "compilerOptions": {
    "allowJs": true,
    "lib": ["deno.window", "deno.ns", "esnext"],
    "strict": true
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "fmt": {
    "singleQuote": true,
    "semiColons": true,
    "lineWidth": 100,
    "indentWidth": 2
  }
}
