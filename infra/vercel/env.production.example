# Shesa — Vercel environment variables — PRODUCTION
#
# Import into BOTH prod projects:
#   • shesa-web-prod   (scope: Production ONLY — do not set Preview)
#   • shesa-admin-prod (scope: Production ONLY)
#
# Vercel Dashboard → project → Settings → Environment Variables
# → Import .env → paste the CONTENTS of this file (after filling values).
#
# After import, flip these to Sensitive (edit → Sensitive toggle):
#   SUPABASE_SERVICE_ROLE_KEY
#   SUPABASE_DB_URL
#   RESEND_API_KEY
#   NEXT_SERVER_ACTIONS_ENCRYPTION_KEY
#
# Production values must be DIFFERENT from staging — never reuse the
# staging Supabase project, Resend key, or encryption key on prod.

# ─────────────────────────────────────────────────────────────
# App identity
# ─────────────────────────────────────────────────────────────
APP_ENV=production
NEXT_PUBLIC_APP_ENV=production

# ─────────────────────────────────────────────────────────────
# Cookie base domain
# ─────────────────────────────────────────────────────────────
APP_BASE_DOMAIN=shesaconnect.com
NEXT_PUBLIC_APP_BASE_DOMAIN=shesaconnect.com

# ─────────────────────────────────────────────────────────────
# Cross-app URLs (apex + subdomain shape for prod)
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_WEB_APP_URL=https://shesaconnect.com
NEXT_PUBLIC_ADMIN_APP_URL=https://admin.shesaconnect.com

# ─────────────────────────────────────────────────────────────
# Supabase — PRODUCTION project (must be a different project than staging)
# Dashboard → Settings → API → Project URL + anon key
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE_PROD_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_PROD_ANON_KEY
SUPABASE_URL=https://REPLACE_PROD_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=REPLACE_PROD_ANON_KEY

# ─────────────────────────────────────────────────────────────
# Supabase secrets — SENSITIVE
# Dashboard → Settings → API → service_role (reveal to copy)
# Dashboard → Settings → Database → Connection string → Transaction pooler (6543)
#   Substitute [YOUR-PASSWORD] with the real DB password.
# ─────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=REPLACE_PROD_SERVICE_ROLE_KEY
SUPABASE_DB_URL=postgresql://postgres.REPLACE_REF:REPLACE_DB_PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres

# ─────────────────────────────────────────────────────────────
# Email (Resend) — API key is SENSITIVE
# Resend → API Keys → create "shesa-prod"
# EMAIL_FROM must use a verified domain in prod (Resend → Domains).
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=re_REPLACE_PROD_KEY
EMAIL_FROM=Shesa <no-reply@shesaconnect.com>

# ─────────────────────────────────────────────────────────────
# SMS provider
# ─────────────────────────────────────────────────────────────
SMS_PROVIDER_MODE=stub

# ─────────────────────────────────────────────────────────────
# Server Actions crypto — SENSITIVE
# Generate locally: `openssl rand -hex 32`
# MUST differ from staging.
# ─────────────────────────────────────────────────────────────
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=REPLACE_WITH_openssl_rand_hex_32_PROD_UNIQUE
