# Dockerfile.vite.prod — production image for Vite SPAs (exco, finance).
#
# Two-stage build:
#   1. `builder` — install workspace deps, vite build the app, produce dist/
#   2. `runner` — nginx:alpine serving the dist/ tree
#
# The runtime image is a few MB (nginx-alpine + the vite bundle). No node,
# no source, no pnpm. The whole SPA is static assets — nginx serves them
# with a spa-router-safe fallback (`try_files ... /index.html`).
#
# Consumed by both deploy-staging.yml and deploy-production.yml with
# APP_DIR (exco | finance) as the build arg.

# ─────────────────────────────────────────────────────────────────────
# Stage 1: install deps + vite build
# ─────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS builder
RUN corepack enable

WORKDIR /app
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps ./apps
COPY packages ./packages

ARG APP_DIR
RUN test -n "$APP_DIR" || (echo "APP_DIR build arg required" && exit 1)

# Only install the deps in this app's transitive graph — a full workspace
# install would drag Next + the auth/web deps we don't need.
RUN --mount=type=cache,id=pnpm,target=/pnpm/store \
    PNPM_STORE_DIR=/pnpm/store pnpm install --frozen-lockfile --filter "@shesa/${APP_DIR}..."

# NEXT_PUBLIC_* values are inlined into the bundle at build time (vite
# via the `define:` shim in the app's vite.config.ts). The values baked
# in HERE are placeholders — the real per-env values are baked in when
# CI rebuilds the image, sourcing them from GitHub Actions env-vars.
ENV NEXT_PUBLIC_APP_ENV=production \
    NEXT_PUBLIC_APP_BASE_DOMAIN=shesa.org \
    NEXT_PUBLIC_SUPABASE_URL=https://build.time.placeholder.example.com \
    NEXT_PUBLIC_SUPABASE_ANON_KEY=build-time-placeholder \
    NEXT_PUBLIC_WEB_APP_URL=https://shesa.org \
    NEXT_PUBLIC_AUTH_APP_URL=https://auth.shesa.org \
    NEXT_PUBLIC_EXCO_APP_URL=https://exco.shesa.org \
    NEXT_PUBLIC_FINANCE_APP_URL=https://finance.shesa.org

RUN pnpm --filter "@shesa/${APP_DIR}" build

# ─────────────────────────────────────────────────────────────────────
# Stage 2: nginx runtime
# ─────────────────────────────────────────────────────────────────────
FROM nginx:1.27-alpine AS runner
ARG APP_DIR
RUN test -n "$APP_DIR" || (echo "APP_DIR build arg required" && exit 1)

# SPA-safe nginx config: fall through to index.html for anything that
# isn't a real static file. Without this, `/dashboard` etc. 404 on
# refresh because there's no matching file on disk.
RUN cat > /etc/nginx/conf.d/default.conf <<'EOF'
server {
  listen 80 default_server;
  root /usr/share/nginx/html;
  index index.html;

  # Cache static assets aggressively — vite fingerprints filenames, so
  # any content change produces a new URL.
  location ~* \.(?:js|css|woff2?|png|jpg|jpeg|gif|webp|avif|svg)$ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    try_files $uri =404;
  }

  # HTML never cached — it references the fingerprinted assets and
  # needs to reflect the latest deploy immediately.
  location = /index.html {
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  # SPA fallback: any other path routes to index.html so react-router
  # can pick it up client-side.
  location / {
    try_files $uri $uri/ /index.html;
  }
}
EOF

COPY --from=builder /app/apps/${APP_DIR}/dist /usr/share/nginx/html

EXPOSE 80
# Nginx's default entrypoint handles SIGTERM + zombie reaping fine —
# no tini needed here.
