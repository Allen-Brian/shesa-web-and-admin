# Dockerfile.next.dev — base dev image for Shesa Next.js apps.
#
# Consumed by every app in apps/* via its own minimal Dockerfile.dev that
# sets the WORKDIR to the app's directory and the command to `pnpm dev`.
# Hot reload comes from a bind-mount in docker-compose.dev.yml, not from
# baking the source into the image.
#
# Image is intentionally large (full toolchain) for dev. The PROD image
# uses a separate multi-stage Dockerfile.next (added in E14) that strips
# everything except the .next build output.

FROM node:22-alpine

# Corepack ships with Node 22 — use it so the project's packageManager
# pin (pnpm@9.15.0) is honored even inside the container.
RUN corepack enable

# Set up a non-root user. Even in dev, running as root inside containers
# is a footgun (file ownership leaks onto the bind-mounted source on the
# host). The UID/GID match the typical Linux dev user; on Mac they're
# remapped transparently.
ARG UID=1000
ARG GID=1000
RUN addgroup -g ${GID} app && adduser -D -u ${UID} -G app app

# pnpm's content-addressable store. Persisting it via a Docker named
# volume between container restarts avoids re-downloading dependencies
# every `docker compose up`.
ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

WORKDIR /app
USER app

# The actual install + dev command runs at container start (not build),
# because the source tree is bind-mounted in. Workflow:
#
#   1. compose mounts the repo at /app
#   2. container runs `pnpm install --filter <app>...` then `pnpm dev`
#
# Each app's Dockerfile.dev (added in E9/E10) sets WORKDIR + CMD.
